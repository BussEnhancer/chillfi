# Server
PORT=5000
NODE_ENV=production

# PostgreSQL — Neon (recommended)
# Paste your Neon connection string here (from neon.tech dashboard → Connection Details)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# PostgreSQL — Alternative (Supabase / local) — only used if DATABASE_URL is not set
# DB_HOST=your-db-host.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your_db_password
# DB_SSL=true

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# MSG91 (OTP)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_template_id

# Cloudinary (Image upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PhonePe (Payment)
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# Delhivery (Shipping)
DELHIVERY_API_KEY=your_delhivery_api_key
DELHIVERY_WAREHOUSE_NAME=ChillFi Warehouse

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Frontend/Website URL (for CORS and payment redirects — use your EC2 IP or domain, NOT Firebase)
FRONTEND_URL=http://3.111.32.220
WEBSITE_URL=http://3.111.32.220
